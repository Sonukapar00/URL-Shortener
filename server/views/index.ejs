<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ"
      crossorigin="anonymous"
    />
    <title>URL Shortener Dashboard</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: 'Inter', sans-serif;
        background: #060b17;
        color: #e6edf8;
      }

      body {
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(56, 189, 248, 0.18), transparent 28%),
          radial-gradient(circle at bottom right, rgba(168, 85, 247, 0.2), transparent 30%),
          #060b17;
      }

      .dashboard-header {
        margin-top: 3rem;
        margin-bottom: 2rem;
      }

      .brand-badge {
        background: linear-gradient(135deg, #6d5dfc, #22d3ee);
        color: #fff;
        border-radius: 999px;
        padding: 0.4rem 0.9rem;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }

      .hero-card,
      .stats-card,
      .table-card {
        background: rgba(16, 24, 40, 0.9);
        border: 1px solid rgba(148, 163, 184, 0.12);
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.35);
        border-radius: 1.25rem;
      }

      .hero-card {
        padding: 2rem;
      }

      .hero-card .form-control {
        border-radius: 1rem;
        min-height: 3.6rem;
        background: rgba(15, 23, 42, 0.95);
        color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, 0.18);
      }

      .hero-card .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(34, 211, 238, 0.22);
        border-color: rgba(56, 189, 248, 0.5);
      }

      .btn-gradient {
        background: linear-gradient(135deg, #6d5dfc, #14b8a6);
        color: #fff;
        border: none;
        box-shadow: 0 12px 24px rgba(20, 184, 166, 0.18);
      }

      .btn-gradient:hover,
      .btn-gradient:focus {
        transform: translateY(-1px);
        box-shadow: 0 16px 28px rgba(20, 184, 166, 0.3);
      }

      .stats-card {
        padding: 1.25rem;
        border-radius: 1.25rem;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .stats-card:hover {
        transform: translateY(-2px);
        border-color: rgba(56, 189, 248, 0.32);
      }

      .stats-card h3 {
        font-size: 1.9rem;
        letter-spacing: -0.03em;
      }

      .table-card {
        padding: 1.25rem;
      }

      .table-card .table {
        color: #cbd5e1;
      }

      .table-card .table thead th {
        border-bottom: 1px solid rgba(148, 163, 184, 0.14);
      }

      .table-card .table tbody tr {
        transition: background-color 0.2s ease, transform 0.2s ease;
      }

      .table-card .table tbody tr:hover {
        background: rgba(29, 78, 216, 0.08);
        transform: translateX(2px);
      }

      .table-card .table td,
      .table-card .table th {
        vertical-align: middle;
        border-top: 1px solid rgba(148, 163, 184, 0.08);
      }

      .table-card .copy-short-url,
      .table-card .btn-delete {
        min-width: 90px;
      }

      .toast-container {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 1100;
      }

      .empty-state {
        min-height: 240px;
        display: grid;
        place-items: center;
        gap: 1rem;
        text-align: center;
        padding: 2.5rem;
        color: #cbd5e1;
      }

      .empty-state h2 {
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
      }

      .empty-state p {
        max-width: 520px;
        margin: 0 auto;
        color: #94a3b8;
      }
    </style>
  </head>
  <body>
    <div class="container py-5">
      <header class="dashboard-header text-white">
        <span class="brand-badge mb-3">Dashboard</span>
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3">
          <div>
            <h1 class="fw-bold mb-2">URL Shortener</h1>
            <p class="mb-0 text-secondary">
              Create, manage, and track your short links in one modern dashboard.
            </p>
          </div>
          <div class="text-sm-end text-secondary">
            <p class="mb-1">Built for fast link sharing and analytics.</p>
            <small>Keep your links clean and easy to reuse.</small>
          </div>
        </div>
      </header>

      <section class="hero-card mb-4">
        <div class="row align-items-center gy-3">
          <div class="col-lg-8">
            <h2 class="fw-semibold mb-3">Shorten URLs in seconds</h2>
            <p class="text-secondary mb-4">
              Paste a destination link below and create a clean short URL that is easy to share.
            </p>
            <form id="shortenForm" action="/shorturls" method="POST" class="row g-2 g-sm-3">
              <div class="col-12 col-md-9">
                <label for="fullUrl" class="form-label visually-hidden">Full URL</label>
                <input
                  id="fullUrl"
                  name="fullUrl"
                  type="url"
                  class="form-control form-control-lg"
                  placeholder="Paste a valid URL like https://example.com"
                  autocomplete="off"
                />
              </div>
              <div class="col-12 col-md-3 d-grid">
                <button id="submitButton" type="submit" class="btn btn-gradient btn-lg">
                  <span id="submitText">Shorten URL</span>
                  <span id="submitSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                </button>
              </div>
            </form>
          </div>
          <div class="col-lg-4">
            <div class="stats-card text-white h-100">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                  <p class="text-uppercase text-secondary mb-1 small">Quick stats</p>
                  <h3 class="mb-0">Keep track of links</h3>
                </div>
                <span class="badge bg-gradient rounded-pill text-white px-3 py-2">Live</span>
              </div>
              <p class="text-secondary mb-0">
                Your dashboard updates instantly. Use the table below to manage links and copy short URLs with one click.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="row g-3 mb-4">
        <div class="col-md-6">
          <article class="stats-card p-4 text-white">
            <small class="text-uppercase text-secondary">Total URLs</small>
            <h3 class="mt-3"><%= shortUrls.length %></h3>
            <p class="mb-0 text-secondary">All links stored in your dashboard.</p>
          </article>
        </div>
        <div class="col-md-6">
          <article class="stats-card p-4 text-white">
            <small class="text-uppercase text-secondary">Total Clicks</small>
            <h3 class="mt-3"><%= shortUrls.reduce((sum, item) => sum + item.clicks, 0) %></h3>
            <p class="mb-0 text-secondary">Total number of times links have been visited.</p>
          </article>
        </div>
      </section>

      <section class="table-card">
        <% if (shortUrls.length === 0) { %>
        <div class="empty-state rounded-4">
          <h2>No URLs Created Yet</h2>
          <p>Start by shortening your first URL. Once links are added, they will appear here with analytics and quick actions.</p>
          <button class="btn btn-gradient btn-lg" onclick="document.getElementById('fullUrl').focus()">Create Link</button>
        </div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0 text-white">
            <thead>
              <tr>
                <th scope="col">Full URL</th>
                <th scope="col">Short URL</th>
                <th scope="col">Clicks</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% shortUrls.forEach((shortUrl) => { %>
              <tr>
                <td class="w-50 text-truncate" style="max-width: 320px;">
                  <a class="text-decoration-none text-info" href="<%= shortUrl.fullUrl %>" target="_blank" rel="noopener noreferrer"><%= shortUrl.fullUrl %></a>
                </td>
                <td class="text-break text-primary">
                  <a class="text-decoration-none" href="/<%= shortUrl.shortCode %>" target="_blank" rel="noopener noreferrer">/<%= shortUrl.shortCode %></a>
                </td>
                <td><span class="badge bg-secondary bg-opacity-15 text-white px-3 py-2"><%= shortUrl.clicks %></span></td>
                <td class="text-end">
                  <div class="d-flex flex-wrap justify-content-end gap-2">
                    <button
                      type="button"
                      class="btn btn-outline-light btn-sm copy-short-url"
                      data-short="<%= shortUrl.shortCode %>"
                    >
                      Copy
                    </button>
                    <form method="POST" action="/delete/<%= shortUrl._id %>" class="m-0">
                      <button type="submit" class="btn btn-danger btn-sm btn-delete">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoYz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
    <script>
      const form = document.getElementById('shortenForm');
      const fullUrlInput = document.getElementById('fullUrl');
      const submitButton = document.getElementById('submitButton');
      const submitText = document.getElementById('submitText');
      const submitSpinner = document.getElementById('submitSpinner');
      const toastContainer = document.getElementById('toastContainer');

      const createToast = (message, type = 'success') => {
        const toastId = `toast-${Date.now()}`;
        const toastEl = document.createElement('div');
        toastEl.className = `toast align-items-center text-bg-${type} border-0`;
        toastEl.id = toastId;
        toastEl.role = 'alert';
        toastEl.ariaLive = 'assertive';
        toastEl.ariaAtomic = 'true';
        toastEl.innerHTML = `
          <div class="d-flex align-items-center gap-2 p-3">
            <div class="toast-body">${message}</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        `;
        toastContainer.appendChild(toastEl);
        const toast = new bootstrap.Toast(toastEl, { delay: 3200 });
        toast.show();
        toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
      };

      const isValidUrl = (value) => {
        if (!value.trim()) return false;
        try {
          const url = new URL(value.trim());
          return url.protocol === 'http:' || url.protocol === 'https:';
        } catch {
          return false;
        }
      };

      const setPendingToast = (message) => localStorage.setItem('pendingToast', message);
      const flushPendingToast = () => {
        const message = localStorage.getItem('pendingToast');
        if (message) {
          createToast(message, 'success');
          localStorage.removeItem('pendingToast');
        }
      };

      document.querySelectorAll('.btn-delete').forEach((button) => {
        button.addEventListener('click', () => {
          setPendingToast('URL deleted successfully');
        });
      });

      form.addEventListener('submit', (event) => {
        const value = fullUrlInput.value;
        if (!isValidUrl(value)) {
          event.preventDefault();
          createToast('Invalid URL entered. Please use https:// or http://', 'danger');
          fullUrlInput.focus();
          return;
        }

        setPendingToast('URL created successfully');
        submitButton.disabled = true;
        submitText.textContent = 'Shortening';
        submitSpinner.classList.remove('d-none');
      });

      document.querySelectorAll('.copy-short-url').forEach((button) => {
        button.addEventListener('click', async () => {
          const shortCode = button.dataset.short;
          const url = `${window.location.origin}/${shortCode}`;
          try {
            await navigator.clipboard.writeText(url);
            createToast('Short URL copied to clipboard!');
          } catch (error) {
            createToast('Unable to copy URL. Please try manually.', 'warning');
          }
        });
      });

      window.addEventListener('DOMContentLoaded', flushPendingToast);
    </script>
  </body>
</html>
